<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Android / Windows / captive portal checks → local "internet OK"
    # (Router DNS = 192.168.1.105 hone par WiFi "no internet" nahi dikhega)
    RewriteRule ^generate_204$ generate_204.php [L]
    RewriteRule ^gen_204$ generate_204.php [L]
    RewriteRule ^hotspot-detect\.html$ hotspot-detect.html [L]
    RewriteRule ^library/test/success\.html$ hotspot-detect.html [L]
    RewriteRule ^connecttest\.txt$ connecttest.txt [L]
    RewriteRule ^ncsi\.txt$ ncsi.txt [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
